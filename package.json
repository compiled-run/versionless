{
	"name": "versionless-workspace",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "vp pack",
		"fmt": "vp fmt",
		"lint": "vp lint",
		"test": "vp test --project 'node-*'",
		"fixture:ingest": "node --experimental-strip-types packages/cli/src/cli.ts fixture:ingest",
		"fixture:verify": "node --experimental-strip-types packages/cli/src/cli.ts fixture:verify",
		"receipt:verify": "node --experimental-strip-types packages/cli/src/cli.ts receipt:verify",
		"corpus:verify": "node --experimental-strip-types packages/cli/src/cli.ts corpus:verify",
		"script-surface:verify": "node --experimental-strip-types packages/cli/src/cli.ts script-surface:verify",
		"runtime-script-observation:verify": "node --experimental-strip-types packages/cli/src/cli.ts runtime-script-observation:verify",
		"trust:ingest": "node --experimental-strip-types packages/cli/src/cli.ts trust:ingest",
		"trust:generate": "node --experimental-strip-types packages/cli/src/cli.ts trust:generate",
		"trust:verify": "node --experimental-strip-types packages/cli/src/cli.ts trust:verify"
	},
	"devDependencies": {
		"@angular/compiler": "22.1.0",
		"@async/witness": "0.9.0",
		"@types/node": "24.12.2",
		"magic-regexp": "^0.11.0",
		"pathe": "^2.0.3",
		"playwright": "1.58.2",
		"typescript": "5.9.3",
		"ufo": "^1.6.4",
		"vite": "8.0.16",
		"vite-plus": "0.1.20",
		"vitest": "4.1.5",
		"yuku-analyzer": "0.7.0",
		"yuku-parser": "0.7.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.2"
}
